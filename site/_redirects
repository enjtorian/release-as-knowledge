# Cloudflare Pages redirect rules
# Format: from to status

# Friendly URLs for manifesto
/manifesto      /                    301
/manifesto/zh   /                    301
/manifesto/en   /en/                 301

# Levels deep-link (scroll to section)
/l1             /#levels              301
/l2             /#levels              301
/l3             /#levels              301
/l4             /#levels              301

# Modes deep-link
/mode-a         /#modes               301
/mode-b         /#modes               301

# Common shortcuts → GitHub repo
/spec           https://github.com/enjtorian/release-as-knowledge/blob/main/docs/manifesto.md   301
/docs           https://github.com/enjtorian/release-as-knowledge/tree/main/docs                301
/sign           https://github.com/enjtorian/release-as-knowledge/blob/main/SIGNATURES.md       301
/repo           https://github.com/enjtorian/release-as-knowledge                                301

# 404 fallback: Cloudflare Pages auto-serves /404.html for unmatched paths.
# Do NOT add an explicit `/* /404.html 404` rule — status 404 is rejected
# by the new Workers-based Pages backend (only 200/301/302/303/307/308 allowed).
